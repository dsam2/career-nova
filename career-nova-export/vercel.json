{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/services", "destination": "/services.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/blogs", "destination": "/blogs.html" },
    { "source": "/case-studies", "destination": "/case-studies.html" },
    { "source": "/services/:slug", "destination": "/services/:slug.html" },
    { "source": "/blogs/:slug", "destination": "/blogs/:slug.html" },
    { "source": "/case-studies/:slug", "destination": "/case-studies/:slug.html" }
  ]
}
