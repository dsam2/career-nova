{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/services/:slug", "destination": "/subpages/services_:slug.html" },
    { "source": "/blogs/:slug", "destination": "/subpages/blogs_:slug.html" },
    { "source": "/case-studies/:slug", "destination": "/subpages/case-studies_:slug.html" },
    { "source": "/about", "destination": "/subpages/about.html" },
    { "source": "/services", "destination": "/subpages/services.html" },
    { "source": "/contact", "destination": "/subpages/contact.html" },
    { "source": "/how-it-works", "destination": "/subpages/how-it-works.html" },
    { "source": "/pricing", "destination": "/subpages/pricing.html" },
    { "source": "/blogs", "destination": "/subpages/blogs.html" },
    { "source": "/case-studies", "destination": "/subpages/case-studies.html" }
  ]
}
